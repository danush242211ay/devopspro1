pipeline{
    agent any

    tools{
        jdk 'java-11'
        maven 'maven'
    }

    stages{
        stage('Git-Checkout'){
            steps{
                git branch: 'main', url: 'https://github.com/danush242211ay/devopspro1.git'
            }
        }
        stage('Compile'){
            steps{
                sh 'mvn compile'
            }
        }
        stage('Build'){
            steps{
                sh 'mvn clean install'
            }
        }
        stage('Build and tag'){
            steps{
                sh "docker build -t danu8747/test:1 ."
            }
        }
        stage('containersation'){
            steps{
                sh '''
                    docker stop c1 || true
                    docker rm c1 || true
                    docker run -it -d --name c1 -p 9001:8080 danu8747/test:1
                ''' 
            }   
        }
    }
}